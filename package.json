{
	"name": "debounce-ts",
	"version": "1.0.1",
	"description": "Small and fast typescript debounce utility library",
	"author": "Atif C <atifcdev@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atif-c/debounce-ts.git"
	},
	"bugs": {
		"url": "https://github.com/atif-c/debounce-ts/issues"
	},
	"homepage": "https://github.com/atif-c/debounce-ts#readme",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"eslint:check": "eslint .",
		"eslint:fix": "eslint --fix .",
		"format": "prettier --write . && eslint --fix .",
		"type-check": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"debounce",
		"debouncing",
		"function",
		"throttle",
		"invoke",
		"limit",
		"limited",
		"interval",
		"rate",
		"batch",
		"rate-limit",
		"async",
		"sync",
		"typescript"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^10.0.2",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.0.18"
	}
}
